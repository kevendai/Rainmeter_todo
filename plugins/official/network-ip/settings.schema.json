{
  "type": "object",
  "properties": {
    "url": {"type": "string", "title": "JSON 请求地址", "default": "https://api.ipify.org?format=json", "x-order": 1},
    "json_path": {"type": "string", "title": "IP 字段", "default": "ip", "x-order": 2},
    "value_name": {"type": "string", "title": "输出变量名", "default": "wan_ip", "x-order": 3},
    "ttl": {"type": "integer", "title": "缓存秒数", "minimum": 30, "maximum": 86400, "default": 300, "x-order": 4},
    "auth_type": {"type": "enum", "title": "认证方式", "enum": ["none", "bearer", "basic"], "default": "none", "x-order": 5},
    "username": {"type": "string", "title": "Basic 用户名", "default": "", "x-order": 6, "x-advanced": true},
    "password": {"type": "password", "title": "Basic 密码", "default": "", "x-secret": true, "x-order": 7, "x-advanced": true},
    "token": {"type": "password", "title": "Bearer Token", "default": "", "x-secret": true, "x-order": 8, "x-advanced": true}
  },
  "required": ["url", "json_path", "value_name"]
}
