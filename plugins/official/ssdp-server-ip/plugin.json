{
  "id": "io.github.kevendai.ssdp-server-ip",
  "name": "SSDP 服务器 IP 同步",
  "version": "1.0.3",
  "api_version": 1,
  "min_host_version": "2.0.0",
  "entry": "bin/SsdpServerIpPlugin.exe",
  "capabilities": [
    "value_provider"
  ],
  "permissions": [
    "network"
  ],
  "settings_schema": "settings.schema.json",
  "homepage": "https://github.com/kevendai/Rainmeter_todo",
  "default_enabled": false,
  "actions": [
    {
      "id": "configure_discovery",
      "name": "搜索并选择 SSDP 服务器",
      "settings_ui": true,
      "long_running": true
    }
  ],
  "address_provider": {
    "priority": 100,
    "value": "server_ip",
    "targets": [
      "calendar.caldav",
      "arxiv.file_server"
    ]
  }
}
