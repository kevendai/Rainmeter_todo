{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rainmeter Desktop Widgets Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "api_version", "min_host_version", "entry", "permissions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "api_version": {"const": 1},
    "min_host_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entry": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"enum": ["todo_source", "todo_transform", "value_provider"]}},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "settings_schema": {"type": "string"},
    "homepage": {"type": "string"},
    "default_enabled": {"type": "boolean"},
    "actions": {"type": "array", "items": {"type": "object"}},

    "provides": {
      "description": "本插件能提供给别的插件的服务（与 capabilities 语义不同，见 docs/V2.1-PROVIDER-INTERFACE.md §1.3）",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+@[0-9]+$"}
    },
    "uses": {
      "description": "本插件需要的服务；provider 由宿主按 plugin-bindings.json 解析，插件不得指定 provider_id",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service"],
        "properties": {
          "service": {"type": "string", "pattern": "^[a-z0-9_]+@[0-9]+$"},
          "binding_key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "optional": {"type": "boolean"}
        }
      }
    },
    "billing": {
      "description": "仅用于设置页/确认框文案与审计，不是可强制的权限",
      "type": "string",
      "enum": ["may_charge", "local", "free"]
    }
  },
  "anyOf": [
    {"required": ["capabilities"], "properties": {"capabilities": {"minItems": 1}}},
    {"required": ["provides"], "properties": {"provides": {"minItems": 1}}}
  ]
}
