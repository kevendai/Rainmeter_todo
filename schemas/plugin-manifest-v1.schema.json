{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rainmeter Desktop Widgets Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "api_version", "min_host_version", "entry", "capabilities", "permissions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "api_version": {"const": 1},
    "min_host_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entry": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["todo_source", "todo_transform", "value_provider"]}},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "settings_schema": {"type": "string"},
    "homepage": {"type": "string"},
    "default_enabled": {"type": "boolean"},
    "actions": {"type": "array", "items": {"type": "object"}}
  }
}
